    "bf16": "the checkpoint's BF16 bytes, verbatim",
    "mxfp8_lt": "producers.mxfp8_lt_from_bf16: per-32 E8M0 + E4M3 RNE from the BF16 source",
    "ple_rows": "not a container tensor: the n-gram table rows live in the PLE row file (ple_rows.py); pulsar.kv names it",
    "kv": "not a container tensor: a small I64 table carried as a pulsar.kv array",
    "exl3m_k3": "turboderp's EXL3 pack: trellis | suh | svh at K = 3, verbatim",
