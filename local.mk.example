# local.mk.example -- copy to local.mk (gitignored) and set the paths the gates you run need.  A variable
# left unset refuses by name only when a recipe that needs it runs (need_path, top of the Makefile); the
# Makefile comment above each variable's ?= line says what it holds.
# LILICORR_DRAFTER ?= /path/to/...
# LILICORR_FIXTURES ?= /path/to/...
# QWEN_GATE_MODEL ?= /path/to/...
# QWEN_REF_ANCHOR_DIR ?= /path/to/...
# NEMOTRON_GATE_MODEL ?= /path/to/...
# LILICORR_GATE_MODEL ?= /path/to/...
# QWEN_TOK_DIR ?= /path/to/...
# QWEN_RENDER_CASES ?= /path/to/...
# QWEN_CALIB ?= /path/to/...
# NEMOTRON_TOK_DIR ?= /path/to/...
# NEMOTRON_ENC_TOK_DIR ?= /path/to/...
# FRONTIER_MODEL ?= /path/to/...
# SMOKE_GEMMA_MODEL ?= /path/to/...
# SMOKE_EMBED_MODEL ?= /path/to/...
# SMOKE_RERANK_MODEL ?= /path/to/...
# SMOKE_PARSE_MODEL ?= /path/to/...
# KV_ADMISSION_MODEL ?= /path/to/...
# KV_HEADROOM_MODEL ?= /path/to/...
# MEM_SQUEEZE_MODEL ?= /path/to/...
# PULSAR_REF_DIR ?= /path/to/...
# QWEN_GEN_MODEL ?= /path/to/...
# QWEN_GEN_TOKENS ?= /path/to/...
